# Copy this file to .env and fill in your own values. .env is never committed.

# Free key from https://aistudio.google.com (API keys page). No billing account needed.
GEMINI_API_KEY=your-key-here

# Chat model and embedding model (run scripts/check_gemini.py to see what your key can use)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Local database started by docker-compose.yml
DATABASE_URL=postgresql://jobmatch:jobmatch@localhost:5433/jobmatch
